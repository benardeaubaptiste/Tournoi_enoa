# Modèle de configuration : copier ce fichier en ".env" puis renseigner les valeurs.
# Le fichier .env contient des secrets : il ne doit JAMAIS être versionné (voir .gitignore).
# En conteneur (Docker), ces variables sont fournies par docker-compose et priment sur le .env.

# --- Application ---
# local | production   (production = erreurs PHP jamais affichées, même si APP_DEBUG=true)
APP_ENV=local
APP_DEBUG=false
# true uniquement si l'application est servie en HTTPS
SESSION_SECURE_COOKIE=false

# Code exigé sur la page d'inscription des gestionnaires. Vide = inscription désactivée.
REGISTRATION_CODE=

# --- Base de données ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tournoi_enoa
DB_USER=
DB_PASSWORD=
