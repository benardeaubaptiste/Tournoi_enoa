# Configuration de PRODUCTION (modèle) : copier en ".env" sur le serveur et remplacer
# toutes les valeurs CHANGE_ME par des secrets forts (ex. : openssl rand -base64 24).

# --- Application ---
APP_ENV=production
APP_DEBUG=false
SESSION_SECURE_COOKIE=true
# Port exposé par le conteneur web sur l'hôte (derrière un reverse proxy HTTPS)
APP_PORT=8080

REGISTRATION_CODE=CHANGE_ME

# --- Base de données (utilisateur dédié, jamais root) ---
DB_HOST=db
DB_PORT=3306
DB_NAME=tournoi_enoa
DB_USER=tournoi_enoa
DB_PASSWORD=CHANGE_ME

# Mot de passe root du conteneur MySQL (utilisé uniquement à sa première initialisation)
MYSQL_ROOT_PASSWORD=CHANGE_ME

# Version de l'image Docker à déployer (ghcr.io/benardeaubaptiste/tournoi_enoa:<version>)
APP_VERSION=latest
